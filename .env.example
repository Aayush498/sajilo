# ---------------------------------------------------------------------------
# Sajilo — environment template. Copy to `.env` and fill in.
# Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
ENVIRONMENT=dev                     # dev | staging | production
DEBUG=true
PROJECT_NAME=Sajilo
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false                      # true in staging/production

# Comma-separated. Use explicit origins in production, never "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Security ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_url_safe_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_HOURS=12

# --- Database ---------------------------------------------------------------
POSTGRES_USER=sajilo
POSTGRES_PASSWORD=sajilo_dev_password
POSTGRES_DB=sajilo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Overrides the parts above if set. Must use the asyncpg driver.
# DATABASE_URL=postgresql+asyncpg://sajilo:sajilo_dev_password@postgres:5432/sajilo

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- OTP / SMS --------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300                 # 5 minutes
OTP_MAX_ATTEMPTS=5                  # wrong-code attempts before the code dies
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_DAY=10

# console = print to logs (dev). sparrow = Sparrow SMS (Nepal).
SMS_PROVIDER=console
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=SajiloNP

# Fixed OTP for these phones, dev/staging only. Lets QA and app-store
# reviewers log in without receiving an SMS. Format: phone:code,phone:code
OTP_TEST_NUMBERS=+9779800000000:123456

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Bootstrap admin (used by `python -m app.cli seed-admin`) ---------------
SEED_ADMIN_PHONE=+9779800000001
SEED_ADMIN_EMAIL=admin@sajilo.com.np
SEED_ADMIN_PASSWORD=ChangeMeNow123!
SEED_ADMIN_NAME=Sajilo Admin
